{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["jest", "node"]
  },
  "include": ["src/core/**/*.ts", "src/render/html.ts", "src/render/__tests__/**/*.ts", "src/export/filename.ts", "src/export/__tests__/**/*.ts"]
}
