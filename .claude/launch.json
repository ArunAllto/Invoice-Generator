{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "start",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start"
      ],
      "port": 3000
    },
    {
      "name": "prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "serve:prod"
      ],
      "autoPort": true
    },
    {
      "name": "subpath",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/serve-static.mjs"
      ],
      "autoPort": true
    }
  ]
}
